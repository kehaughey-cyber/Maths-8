/-- Integer dot product of two coordinate lists. -/
def dotL (a b : List Int) : Int := (a.zip b).foldl (fun s p => s + p.1 * p.2) 0

/-- The E8 Gram H (= container 06's half_gram): even, unimodular (det 1), rank 8. -/
