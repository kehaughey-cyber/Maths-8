   [1, 2, 2, 1, 2, 4, 0, 0],
   [1, 1, -1, 0, 0, 0, 2, 2],
   [1, 2, -1, -1, 0, 0, 2, 4]]

/-- The quadratic form c^T H c (the squared length of a lattice vector with coords c). -/
def qform (c : Vec) : Int := dotL c (H.map (fun row => dotL row c))

/-- Negation of a coordinate vector. -/
def negV (c : Vec) : Vec := c.map (fun x => -x)

